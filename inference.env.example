# Inference endpoint. compose.yaml loads inference.env into the app container
# (env_file), so copy this file to inference.env and fill in your team's values.
# Read these EXACT variable names in your app (do not rename them). The endpoint
# is OpenAI-compatible, so the `openai` SDK picks up OPENAI_BASE_URL /
# OPENAI_API_KEY automatically. Never commit inference.env (it is in .gitignore).

OPENAI_BASE_URL=https://api.swissai.svc.cscs.ch/v1
OPENAI_API_KEY=sk-changeme                    # your team's key, handed out at the kickoff
MODEL=CSCS-Inference/google/gemma-4-31B-it    # or RCP-AIaaS/swiss-ai/Apertus-large, see the website
