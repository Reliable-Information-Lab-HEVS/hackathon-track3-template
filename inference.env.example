# Inference endpoint — the organisers pass a file like this at deploy time via
#   docker run --env-file inference.env ...
# Read these EXACT variable names in your app (do not rename them). The endpoint
# is an OpenAI-compatible LiteLLM proxy, so the `openai` SDK picks up
# OPENAI_BASE_URL / OPENAI_API_KEY automatically.
#
# For local development, copy this file to inference.env and fill in your own key.

OPENAI_BASE_URL=https://litellm.hackathon.intlab.ch/v1
OPENAI_API_KEY=sk-changeme          # real key provided at deploy
MODEL=swiss-ai/Apertus-70B-Instruct-2509   # or another id from /v1/models, see the website
